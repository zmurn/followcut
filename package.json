{
  "name": "followcut",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "description": "FOLLOW/CUT \u2014 a local-first Instagram following curator. Import your export, review like a deck, confirm unfollows yourself.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-singlefile.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "qa": "npm run test:all",
    "share": "npm run build && node scripts/share-server.mjs"
  },
  "dependencies": {
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
